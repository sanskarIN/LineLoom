{
  "name": "lineloom",
  "displayName": "LineLoom",
  "version": "1.3.0",
  "publisher": "SanskarCodes",
  "description": "Privacy-first, open-source AI code autocomplete for VS Code, powered by local models.",
  "license": "MIT",
  "private": false,
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "autocomplete",
    "ollama",
    "local-ai",
    "typescript",
    "python",
    "rust",
    "kotlin",
    "privacy-first",
    "go",
    "java",
    "c",
    "cpp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sanskarIN/LineLoom.git"
  },
  "bugs": {
    "url": "https://github.com/sanskarIN/LineLoom/issues"
  },
  "homepage": "https://sanskarin.github.io/LineLoom/",
  "activationEvents": [
    "onStartupFinished",
    "onView:lineloom.dashboard"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lineloom.enable",
        "title": "Enable Autocomplete",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.disable",
        "title": "Disable Autocomplete",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.trigger",
        "title": "Trigger Completion",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.cancel",
        "title": "Stop Current Generation",
        "category": "LineLoom",
        "icon": "$(debug-stop)"
      },
      {
        "command": "lineloom.quickActions",
        "title": "Quick Actions",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.toggleAutomatic",
        "title": "Pause or Resume Automatic Suggestions",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.selectModel",
        "title": "Select Model",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.selectLanguageModel",
        "title": "Assign Language Model",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.checkActiveFilePrivacy",
        "title": "Check Active File Privacy",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.selectRelatedFiles",
        "title": "Select Related Files for Context",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.clearRelatedFiles",
        "title": "Clear Selected Related Files",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.checkConnection",
        "title": "Check Ollama Connection",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.openSettings",
        "title": "Open Settings",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.diagnostics",
        "title": "Open Diagnostics",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.resetPrivacyTimings",
        "title": "Reset Privacy Timing Statistics",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.setup",
        "title": "Show Setup Guide",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.performance",
        "title": "Show Completion Performance",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.manageLanguages",
        "title": "Manage Autocomplete Languages",
        "category": "LineLoom"
      },
      {
        "command": "lineloom.refreshSidebar",
        "title": "Refresh Sidebar",
        "category": "LineLoom",
        "icon": "$(refresh)"
      },
      {
        "command": "lineloom.openSidebar",
        "title": "Open Control Center",
        "category": "LineLoom"
      }
    ],
    "configuration": {
      "title": "LineLoom",
      "properties": {
        "lineloom.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline code completion."
        },
        "lineloom.enabledLanguages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "python",
              "javascript",
              "typescript",
              "rust",
              "kotlin",
              "go",
              "java",
              "c",
              "cpp"
            ]
          },
          "default": [
            "python",
            "javascript",
            "typescript",
            "rust",
            "kotlin",
            "go",
            "java",
            "c",
            "cpp"
          ],
          "uniqueItems": true,
          "description": "Language IDs permitted for inline suggestions. Empty array disables completion for every language. JSX/TSX follow JavaScript/TypeScript."
        },
        "lineloom.autoTrigger": {
          "type": "boolean",
          "default": true,
          "description": "Allow suggestions while typing; manual triggers remain available."
        },
        "lineloom.minAutoTriggerChars": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 32,
          "description": "Minimum non-whitespace characters typed on the current line before an automatic model request; manual completion is always available."
        },
        "lineloom.model": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Installed Ollama model to use. No models are downloaded automatically."
        },
        "lineloom.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama HTTP endpoint. Remote endpoints require explicit separate approval."
        },
        "lineloom.allowRemoteEndpoints": {
          "type": "boolean",
          "default": false,
          "description": "Permit explicitly approved remote HTTPS inference endpoints. Source code may leave your machine."
        },
        "lineloom.debounceMs": {
          "type": "integer",
          "default": 250,
          "minimum": 0,
          "maximum": 3000
        },
        "lineloom.timeoutMs": {
          "type": "integer",
          "default": 12000,
          "minimum": 1000,
          "maximum": 120000
        },
        "lineloom.maxContextChars": {
          "type": "integer",
          "default": 8000,
          "minimum": 512,
          "maximum": 30000
        },
        "lineloom.maxOutputTokens": {
          "type": "integer",
          "default": 128,
          "minimum": 16,
          "maximum": 512
        },
        "lineloom.multiLine": {
          "type": "boolean",
          "default": true
        },
        "lineloom.maxSuggestionLines": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum lines to offer per inline suggestion (single-line mode always uses one line)."
        },
        "lineloom.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1
        },
        "lineloom.contextSize": {
          "type": "integer",
          "default": 4096,
          "minimum": 512,
          "maximum": 32768
        },
        "lineloom.keepAlive": {
          "type": "string",
          "default": "5m"
        },
        "lineloom.excludedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional ignored paths relative to workspace root (gitignore syntax)."
        },
        "lineloom.crossFileContext": {
          "type": "boolean",
          "default": false,
          "description": "Experimental, disabled by default. Only explicitly selected, same-workspace, privacy-eligible small source files may enter local Ollama prompts; any remote inference requires separate approval. Selection is session-only."
        },
        "lineloom.performanceDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Track privacy-preserving aggregate performance timings in memory."
        },
        "lineloom.suppressMidTokenAuto": {
          "type": "boolean",
          "default": true,
          "description": "Avoid automatic Ollama requests when the cursor is directly before an existing identifier character. Explicit manual completions bypass this guard."
        },
        "lineloom.languageModels": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional installed Ollama model tags for specific language IDs (python, javascript, typescript, rust, kotlin, go, java, c, cpp). Empty or unknown mappings are ignored; JSX/TSX follow JavaScript/TypeScript. Other languages use lineloom.model. No model downloads are performed."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lineloom",
          "title": "LineLoom",
          "icon": "assets/icons/sidebar.svg"
        }
      ]
    },
    "views": {
      "lineloom": [
        {
          "id": "lineloom.dashboard",
          "name": "Control Center"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "lineloom.refreshSidebar",
          "when": "view == lineloom.dashboard",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check src test scripts package.json",
    "test": "vitest run test/unit",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:qa && npm run test:source-tree && npm run test:packager-security && npm run test:site && npm run build",
    "package": "npm run check && vsce package --no-dependencies",
    "package:list": "vsce ls --no-dependencies",
    "test:integration": "node scripts/integration.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "qa:ollama": "node scripts/qa-local-ollama.mjs",
    "test:qa": "node --test scripts/check-qa-local-ollama.mjs",
    "package:preview": "npm run check && vsce package --pre-release --no-dependencies",
    "test:site": "node --test scripts/verify-site.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "test:install-vsix": "node scripts/smoke-install-vsix.mjs",
    "test:upgrade-vsix": "node scripts/smoke-upgrade-vsix.mjs",
    "package:stable": "npm run package",
    "test:source-tree": "node --test scripts/check-source-tree.mjs && node scripts/verify-source-tree.mjs",
    "test:packager-security": "node --test scripts/check-packager-deps.test.mjs && node scripts/check-packager-deps.mjs"
  },
  "dependencies": {
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.12.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "icon": "assets/icons/lineloom.png",
  "overrides": {
    "@azure/identity": "4.2.1"
  }
}
